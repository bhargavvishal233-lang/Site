# ==============================================================================
# SPECTRUM CONFIGURATION & NOTIFICATIONS
# ==============================================================================

# Admin Notification Email (where alerts about new sign-ins/sign-ups are sent)
ADMIN_NOTIFICATION_EMAIL="sspectrumm0112@gmail.com"

# Email Sender Name & Address shown to clients
# Example: "Spectrum <notifications@spectrum.agency>"
# When testing with Resend's free tier without a custom domain, use: "Spectrum <onboarding@resend.dev>"
EMAIL_FROM="Spectrum <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# OPTION 1: Resend (Recommended - Instant Setup, No packages required)
# Get a free key at: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# OPTION 2: Gmail / SMTP (Alternative)
# If using Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# GMAIL_USER="sspectrumm0112@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Or Custom SMTP:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASS="pass"

# ------------------------------------------------------------------------------
# CLERK AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk Webhooks Signing Secret (from Clerk Dashboard > Webhooks > Endpoint Signing Secret)
# Used to verify inbound webhooks from Clerk at /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/spectrum_dev"
